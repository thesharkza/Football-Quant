# คัดลอกเป็น .streamlit/secrets.toml (ห้าม commit) หรือวางในหน้า Secrets ของ Streamlit Cloud
# หมายเหตุ: บรรทัดแบบ KEY = "..." ต้องอยู่ "ก่อน" หัวข้อ [auth] เสมอ
GEMINI_API_KEY = "..."
ADMIN_EMAILS = "you@gmail.com"      # Admin (คั่นด้วยจุลภาคได้หลายอีเมล)
# SESSION_MINUTES = "10"            # หมดเวลาเมื่อไม่ได้ใช้งาน (นาที)
SHEETS_URL = "https://script.google.com/macros/s/.../exec"
SHEETS_TOKEN = "รหัสลับเดียวกับ TOKEN ใน Code.gs"
# APP_PASSWORD = "..."              # ใช้เฉพาะเมื่อไม่ตั้ง [auth] (โหมดรหัสผ่านเดิม = Admin)

[auth]
redirect_uri = "https://<ชื่อแอปของคุณ>.streamlit.app/oauth2callback"
cookie_secret = "สุ่มข้อความยาว ๆ อย่างน้อย 32 ตัวอักษร"
client_id = "xxxx.apps.googleusercontent.com"
client_secret = "GOCSPX-xxxx"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
